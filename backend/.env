APP_NAME="API Anomaly Detection Backend"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-secret-key-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

POSTGRES_DB=api_anomaly
POSTGRES_USER=api_anomaly
POSTGRES_PASSWORD=api_anomaly_password
POSTGRES_PORT=5433
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://api_anomaly:api_anomaly_password@localhost:5433/api_anomaly
